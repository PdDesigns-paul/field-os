# Talk is the only cloud. These never ship in the PWA.
# Server-only on the Vercel function.

# xAI first. OpenRouter-shaped routing later.
XAI_API_KEY=

# Optional. If set, Talk may route through OpenRouter instead of xAI direct.
# OPENROUTER_API_KEY=

# Cheap Live / dear Roleplay. Client cannot override.
# TALK_MODEL_LIVE=grok-4-fast
# TALK_MODEL_ROLEPLAY=grok-4

# Optional shop grant. Public /api/talk without this is a firehose. See docs/GAPS.md.
# TALK_GRANT_SECRET=
